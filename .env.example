# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
FAMILY_CHAT_ID=your_family_chat_id_here
EMERGENCY_CHAT_ID=your_emergency_chat_id_here   # can match FAMILY_CHAT_ID

# ── n8n alert router ──────────────────────────────────────────────────────────
N8N_ALERT_URL=http://localhost:5678/webhook-test/care-alert
CARE_SHARED_SECRET=generate_with_node_crypto_randomBytes_32_hex

# ── Call behaviour ────────────────────────────────────────────────────────────
RING_TIMEOUT_SECONDS=30
SPEECH_LANG=en-IN

# ── Phone-page timing (ms) ────────────────────────────────────────────────────
NEXT_PUBLIC_POST_SPEAK_GAP_MS=500
NEXT_PUBLIC_SPEAK_SETTLE_MS=350
NEXT_PUBLIC_UTTERANCE_END_SILENCE_MS=1500
NEXT_PUBLIC_LISTEN_TIMEOUT_MS=12000
NEXT_PUBLIC_MAX_CALL_TURNS=8
NEXT_PUBLIC_SPEECH_LANG=en-IN
